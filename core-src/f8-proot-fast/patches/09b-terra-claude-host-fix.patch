--- a/tests/test-terra-proc-fd-reopen.c
+++ b/tests/test-terra-proc-fd-reopen.c
@@ -0,0 +1,202 @@
+#define _GNU_SOURCE
+#include <errno.h>
+#include <fcntl.h>
+#include <linux/memfd.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/syscall.h>
+#include <sys/types.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+static int check_closed_after_exec(const char *self, int fd) {
+	int pipefd[2];
+	pid_t pid;
+	int status;
+	char result = 0;
+	char fd_text[32];
+	char pipe_text[32];
+
+	if (pipe(pipefd) != 0) {
+		perror("pipe");
+		return 1;
+	}
+	pid = fork();
+	if (pid < 0) {
+		perror("fork");
+		return 1;
+	}
+	if (pid == 0) {
+		close(pipefd[0]);
+		snprintf(fd_text, sizeof(fd_text), "%d", fd);
+		snprintf(pipe_text, sizeof(pipe_text), "%d", pipefd[1]);
+		execl(self, self, "--check-closed", fd_text, pipe_text, (char *)NULL);
+		perror("execl");
+		_exit(127);
+	}
+	close(pipefd[1]);
+	if (read(pipefd[0], &result, 1) != 1 || result != 'C') {
+		fprintf(stderr, "exec did not confirm FD_CLOEXEC for fd %d\n", fd);
+		return 1;
+	}
+	if (waitpid(pid, &status, 0) != pid || !WIFEXITED(status) || WEXITSTATUS(status) != 0) {
+		fprintf(stderr, "exec helper failed for fd %d\n", fd);
+		return 1;
+	}
+	return 0;
+}
+
+static int check_readonly_reopen(const char *name, const char *self, int source_fd,
+				 int use_proc_path) {
+	char proc_path[64];
+	const char *path = proc_path;
+	int reopened;
+	int status_flags;
+	int descriptor_flags;
+
+	if (use_proc_path) {
+		snprintf(proc_path, sizeof(proc_path), "/proc/self/fd/%d", source_fd);
+	} else {
+		path = name;
+	}
+	reopened = open(path, O_RDONLY | O_CLOEXEC);
+	if (reopened < 0) {
+		fprintf(stderr, "%s: open(%s) failed: %s\n", name, path, strerror(errno));
+		return 1;
+	}
+	status_flags = fcntl(reopened, F_GETFL);
+	if (status_flags < 0 || (status_flags & O_ACCMODE) != O_RDONLY) {
+		fprintf(stderr, "%s: F_GETFL=%#x, expected O_RDONLY\n", name, status_flags);
+		return 1;
+	}
+	descriptor_flags = fcntl(reopened, F_GETFD);
+	if (descriptor_flags < 0 || !(descriptor_flags & FD_CLOEXEC)) {
+		fprintf(stderr, "%s: F_GETFD=%#x, expected FD_CLOEXEC\n", name, descriptor_flags);
+		return 1;
+	}
+	if (write(reopened, "x", 1) != -1 || errno != EBADF) {
+		fprintf(stderr, "%s: readonly descriptor accepted write\n", name);
+		return 1;
+	}
+	if (check_closed_after_exec(self, reopened) != 0) {
+		return 1;
+	}
+	close(reopened);
+	printf("PASS %s\n", name);
+	return 0;
+}
+
+static int check_android_memfd_rejected(void) {
+	char proc_path[64];
+	int memfd;
+	int reopened;
+
+	memfd = (int)syscall(SYS_memfd_create, "terra-proc-fd", MFD_CLOEXEC);
+	if (memfd < 0 || ftruncate(memfd, 4096) != 0 || write(memfd, "data", 4) != 4) {
+		perror("memfd create/setup");
+		return 1;
+	}
+	snprintf(proc_path, sizeof(proc_path), "/proc/self/fd/%d", memfd);
+	errno = 0;
+	reopened = open(proc_path, O_RDONLY | O_CLOEXEC);
+	if (reopened != -1 || errno != EACCES) {
+		fprintf(stderr, "memfd proc reopen result=%d errno=%d, expected EACCES\n", reopened, errno);
+		return 1;
+	}
+	close(memfd);
+	puts("PASS memfd-proc-fd-is-rejected");
+	return 0;
+}
+
+static int check_chromium_fallback(const char *self) {
+	char path[] = "/tmp/terra-chromium-fallback-XXXXXX";
+	int memfd;
+	int fallback_fd;
+	int failed;
+
+	errno = 0;
+	memfd = (int)syscall(SYS_memfd_create, "shared-memory-region",
+		MFD_CLOEXEC | MFD_ALLOW_SEALING);
+	if (memfd != -1 || errno != ENOSYS) {
+		fprintf(stderr, "shared-memory-region result=%d errno=%d, expected ENOSYS\n", memfd, errno);
+		return 1;
+	}
+	fallback_fd = mkstemp(path);
+	if (fallback_fd < 0 || write(fallback_fd, "data", 4) != 4) {
+		perror("fallback file");
+		return 1;
+	}
+	failed = check_readonly_reopen(path, self, fallback_fd, 0);
+	close(fallback_fd);
+	unlink(path);
+	if (failed != 0)
+		return 1;
+	puts("PASS chromium-shared-memory-fallback");
+	return 0;
+}
+
+static int check_stdio_reopen(const char *self) {
+	int source_flags = fcntl(STDOUT_FILENO, F_GETFL);
+	int reopened = open("/dev/fd/1", O_WRONLY | O_CLOEXEC);
+	int status_flags;
+	int descriptor_flags;
+
+	if (source_flags < 0 || reopened < 0) {
+		perror("stdio /dev/fd");
+		return 1;
+	}
+	status_flags = fcntl(reopened, F_GETFL);
+	descriptor_flags = fcntl(reopened, F_GETFD);
+	if ((status_flags & O_ACCMODE) != (source_flags & O_ACCMODE) ||
+	    !(descriptor_flags & FD_CLOEXEC) || check_closed_after_exec(self, reopened) != 0) {
+		fprintf(stderr, "stdio source=%#x reopened=%#x fdflags=%#x\n",
+			source_flags, status_flags, descriptor_flags);
+		return 1;
+	}
+	if (write(reopened, "PASS stdio-dev-fd\n", 18) != 18) {
+		perror("stdio write");
+		return 1;
+	}
+	close(reopened);
+	return 0;
+}
+
+int main(int argc, char **argv) {
+	char path[] = "/tmp/terra-proc-fd-XXXXXX";
+	int regular_fd;
+	int opath_fd;
+	int failures = 0;
+
+	if (argc == 4 && strcmp(argv[1], "--check-closed") == 0) {
+		int closed_fd = atoi(argv[2]);
+		int notify_fd = atoi(argv[3]);
+		if (fcntl(closed_fd, F_GETFD) != -1 || errno != EBADF) {
+			return 1;
+		}
+		return write(notify_fd, "C", 1) == 1 ? 0 : 1;
+	}
+
+	regular_fd = mkstemp(path);
+	if (regular_fd < 0 || write(regular_fd, "data", 4) != 4) {
+		perror("mkstemp/write");
+		return 1;
+	}
+	failures += check_readonly_reopen(path, argv[0], regular_fd, 0);
+	failures += check_readonly_reopen("regular-proc-fd", argv[0], regular_fd, 1);
+	failures += check_android_memfd_rejected();
+	failures += check_chromium_fallback(argv[0]);
+
+	opath_fd = open(path, O_PATH | O_CLOEXEC);
+	if (opath_fd < 0) {
+		perror("open O_PATH");
+		return 1;
+	}
+	failures += check_readonly_reopen("O_PATH-proc-fd", argv[0], opath_fd, 1);
+	failures += check_stdio_reopen(argv[0]);
+
+	close(opath_fd);
+	close(regular_fd);
+	unlink(path);
+	return failures == 0 ? 0 : 1;
+}
