diff --git a/src/extension/link2symlink/link2symlink.c b/src/extension/link2symlink/link2symlink.c
index 11f27bd..232a0fc 100644
--- a/src/extension/link2symlink/link2symlink.c
+++ b/src/extension/link2symlink/link2symlink.c
@@ -1580,6 +1580,37 @@ static void link2symlink_handle_statx(struct statx_syscall_state *state)
 	state->updated_stats = true;
 }
 
+static int link2symlink_handle_stat(struct stat_syscall_state *state)
+{
+	char intermediate[PATH_MAX];
+	const char *name;
+	int link_count;
+
+	if (state->host_path == NULL || state->host_path[0] == '\0')
+		return 0;
+
+	if (S_ISLNK(state->stat_buf->st_mode)) {
+		name = strrchr(state->host_path, '/');
+		name = (name != NULL) ? name + 1 : state->host_path;
+		if (strncmp(name, PREFIX, strlen(PREFIX)) == 0)
+			return -EAGAIN;
+
+		if (my_readlink(state->host_path, intermediate) >= 0) {
+			name = strrchr(intermediate, '/');
+			name = (name != NULL) ? name + 1 : intermediate;
+			if (strncmp(name, PREFIX, strlen(PREFIX)) == 0)
+				return -EAGAIN;
+		}
+		return 0;
+	}
+
+	link_count = get_link_count(state->host_path);
+	if (link_count >= 0)
+		state->stat_buf->st_nlink = link_count;
+
+	return 0;
+}
+
 /**
  * Remember the name the tracee of @extension used for the file it is
  * about to open, when @host_path -- the path this open was redirected
@@ -2051,6 +2082,9 @@ int link2symlink_callback(Extension *extension, ExtensionEvent event,
 		translated_path(extension, (char *) data1);
 		return 0;
 
+	case STAT_SYSCALL:
+		return link2symlink_handle_stat((struct stat_syscall_state *) data1);
+
 	case STATX_SYSCALL:
 		link2symlink_handle_statx((struct statx_syscall_state *) data1);
 		return 0;
diff --git a/src/syscall/enter.c b/src/syscall/enter.c
index 56e9fa2..b9a360b 100644
--- a/src/syscall/enter.c
+++ b/src/syscall/enter.c
@@ -77,10 +77,12 @@
 #include "tracee/mem.h"
 #include "tracee/abi.h"
 #include "tracee/event.h"
+#include "tracee/statx.h"
 #include "path/path.h"
 #include "path/canon.h"
 #include "path/binding.h"
 #include "arch.h"
+#include <sys/syscall.h>
 
 /* Older kernel headers may lack these. */
 #ifndef CLONE_NEWTIME
@@ -2641,6 +2643,133 @@ static void maybe_redirect_userns_file(Tracee *tracee, Reg reg, int flags)
 	(void) set_sysarg_path(tracee, "/dev/null", reg);
 }
 
+static void answer_syscall_at_enter(Tracee *tracee, word_t result)
+{
+	set_sysnum(tracee, PR_void);
+	poke_reg(tracee, SYSARG_2, peek_reg(tracee, ORIGINAL, SYSARG_2));
+	poke_reg(tracee, SYSARG_3, peek_reg(tracee, ORIGINAL, SYSARG_3));
+	poke_reg(tracee, SYSARG_4, peek_reg(tracee, ORIGINAL, SYSARG_4));
+	poke_reg(tracee, SYSARG_5, peek_reg(tracee, ORIGINAL, SYSARG_5));
+	poke_reg(tracee, SYSARG_6, peek_reg(tracee, ORIGINAL, SYSARG_6));
+	poke_reg(tracee, SYSARG_RESULT, result);
+	tracee->answered_at_enter = true;
+	tracee->restart_how = PTRACE_CONT;
+}
+
+/**
+ * Answer stat-family syscalls (newfstatat/fstatat64, fstat, statx) directly at
+ * the seccomp enter stop when safe, sparing the sysexit ptrace stop and
+ * duplicate exit-stage path resolution.  Unusual flags, /proc paths, non-native
+ * ABIs, chained syscalls, and host errors other than ENOENT/ENOTDIR fall back
+ * to the normal enter+exit path.
+ */
+static bool answer_stat_at_enter(Tracee *tracee)
+{
+#ifdef USERLAND
+	(void) tracee;
+	return false;
+#else
+	struct stat st;
+	struct stat_syscall_state state;
+	char path[PATH_MAX];
+	Sysnum sysnum;
+	Reg buffer;
+	int status;
+
+	/* Only when the kernel cancels PR_void (native 64-bit / non-ARM32). */
+	if ((long) SYSCALL_AVOIDER >= 0)
+		return false;
+
+	sysnum = get_sysnum(tracee, ORIGINAL);
+	if (get_sysnum(tracee, CURRENT) != sysnum || tracee->chain.syscalls != NULL
+	    || tracee->sysexit_pending || get_abi(tracee) != ABI_DEFAULT)
+		return false;
+
+	if (sysnum == PR_newfstatat || sysnum == PR_fstatat64) {
+#ifdef __NR_newfstatat
+		word_t flags = peek_reg(tracee, CURRENT, SYSARG_4);
+
+		if ((flags & ~(word_t) (AT_SYMLINK_NOFOLLOW | AT_NO_AUTOMOUNT)) != 0)
+			return false;
+		status = read_path(tracee, path, peek_reg(tracee, CURRENT, SYSARG_2));
+		if (status < 0 || path[0] != '/')
+			return false;
+		if (strncmp(path, "/proc", 5) == 0 && (path[5] == '/' || path[5] == '\0'))
+			return false;
+
+		if (syscall(__NR_newfstatat, AT_FDCWD, path, &st, (int) flags) != 0) {
+			const int error = errno;
+			if (error != ENOENT && error != ENOTDIR) {
+				VERBOSE(tracee, 2, "stat_at_enter: skip host errno=%d %s", error, path);
+				return false;
+			}
+			VERBOSE(tracee, 2, "stat_at_enter: answered errno=%d %s", error, path);
+			answer_syscall_at_enter(tracee, (word_t) -error);
+			return true;
+		}
+		buffer = SYSARG_3;
+#else
+		return false;
+#endif
+	}
+	else if (sysnum == PR_statx) {
+		word_t result;
+		if (answer_statx_at_enter(tracee, &result) != 1)
+			return false;
+		VERBOSE(tracee, 2, "stat_at_enter: answered statx result=%ld", (long) result);
+		answer_syscall_at_enter(tracee, result);
+		return true;
+	}
+	else if (sysnum == PR_fstat) {
+#if defined(__NR_fstat) && defined(__NR_pidfd_open) && defined(__NR_pidfd_getfd)
+		const int fd = (int) peek_reg(tracee, CURRENT, SYSARG_1);
+		int pidfd, local, saved;
+
+		if (fd < 0)
+			return false;
+		pidfd = (int) syscall(__NR_pidfd_open, tracee->pid, 0);
+		if (pidfd < 0)
+			return false;
+		local = (int) syscall(__NR_pidfd_getfd, pidfd, fd, 0);
+		saved = errno;
+		close(pidfd);
+		if (local < 0) {
+			VERBOSE(tracee, 2, "stat_at_enter: skip fstat getfd errno=%d fd=%d", saved, fd);
+			return false;
+		}
+		status = (int) syscall(__NR_fstat, local, &st);
+		close(local);
+		if (status != 0)
+			return false;
+
+		path[0] = '\0';
+		if (tracee->extensions != NULL && readlink_proc_pid_fd(tracee->pid, fd, path) >= 0) {
+			const size_t length = strlen(path), suffix = strlen(" (deleted)");
+			if (length > suffix && strcmp(path + length - suffix, " (deleted)") == 0)
+				path[length - suffix] = '\0';
+		}
+		buffer = SYSARG_2;
+#else
+		return false;
+#endif
+	}
+	else
+		return false;
+
+	state.host_path = path;
+	state.stat_buf = &st;
+	if (notify_extensions(tracee, STAT_SYSCALL, (intptr_t) &state, 0) < 0)
+		return false;
+
+	if (write_data(tracee, peek_reg(tracee, ORIGINAL, buffer), &st, sizeof(st)) < 0)
+		return false;
+
+	VERBOSE(tracee, 2, "stat_at_enter: answered %s", sysnum == PR_fstat ? "fstat" : path);
+	answer_syscall_at_enter(tracee, 0);
+	return true;
+#endif
+}
+
 /**
  * Translate the input arguments of the current @tracee's syscall in the
  * @tracee->pid process area. This function sets @tracee->status to
@@ -4011,5 +4140,8 @@ end:
 		set_sysnum(tracee, PR_void);
 	}
 
+	if (status >= 0 && tracee->seccomp_enter_skippable)
+		(void) answer_stat_at_enter(tracee);
+
 	return status;
 }
diff --git a/src/tracee/event.c b/src/tracee/event.c
index 9b8993f..b886a18 100644
--- a/src/tracee/event.c
+++ b/src/tracee/event.c
@@ -735,7 +735,15 @@ int handle_tracee_event(Tracee *tracee, int tracee_status)
 			if ((flags & FILTER_SYSEXIT) != 0 || sysexit_necessary) {
 				if (seccomp_after_ptrace_enter) {
 					tracee->restart_how = PTRACE_SYSCALL;
+					tracee->seccomp_enter_skippable = !sysexit_necessary;
+					tracee->answered_at_enter = false;
 					translate_syscall(tracee);
+					tracee->seccomp_enter_skippable = false;
+					if (tracee->answered_at_enter) {
+						tracee->answered_at_enter = false;
+						tracee->restart_how = PTRACE_CONT;
+						break;
+					}
 				}
 				tracee->restart_how = PTRACE_SYSCALL;
 				break;
diff --git a/src/tracee/statx.c b/src/tracee/statx.c
index 3ddc6bb..ec97c5c 100644
--- a/src/tracee/statx.c
+++ b/src/tracee/statx.c
@@ -1,8 +1,13 @@
 #include <errno.h>          /* E*, */
+#include <fcntl.h>          /* AT_*, */
+#include <string.h>         /* strncmp(3), */
+#include <unistd.h>         /* syscall(2), close(2), */
+#include <sys/syscall.h>    /* __NR_statx, __NR_pidfd_*, */
 #include <sys/sysmacros.h>  /* major, minor, */
 
 #include "tracee/statx.h"
 #include "tracee/mem.h"
+#include "tracee/reg.h"
 
 int handle_statx_syscall(Tracee *tracee, bool from_sigsys) {
 	RegVersion regVersion = from_sigsys ? CURRENT : ORIGINAL;
@@ -176,3 +181,89 @@ int handle_statx_syscall(Tracee *tracee, bool from_sigsys) {
 	}
 	return 0;
 }
+
+#ifndef AT_STATX_SYNC_TYPE
+#define AT_STATX_SYNC_TYPE 0x6000
+#endif
+
+/**
+ * Answer statx(2) directly at the seccomp enter stop using the host path
+ * already translated in CURRENT SYSARG_2 (or pidfd_getfd() for AT_EMPTY_PATH),
+ * then invoke STATX_SYSCALL extensions and write the result back.  Returns 1
+ * with *result set when answered, or 0 to fall back to the normal enter+exit
+ * path (unusual flags, /proc paths, kernel lack of statx/pidfd_getfd, or host
+ * errors other than ENOENT/ENOTDIR).
+ */
+int answer_statx_at_enter(Tracee *tracee, word_t *result)
+{
+#if defined(__NR_statx)
+	struct statx_syscall_state state = {};
+	const word_t dirfd = peek_reg(tracee, CURRENT, SYSARG_1);
+	const word_t flags = peek_reg(tracee, CURRENT, SYSARG_3);
+	const word_t mask = peek_reg(tracee, CURRENT, SYSARG_4);
+	int status;
+	long rc;
+
+	if ((flags & ~(word_t) (AT_SYMLINK_NOFOLLOW | AT_NO_AUTOMOUNT | AT_EMPTY_PATH | AT_STATX_SYNC_TYPE)) != 0)
+		return 0;
+
+	status = read_string(tracee, state.host_path, peek_reg(tracee, CURRENT, SYSARG_2), PATH_MAX);
+	if (status <= 0 || status >= PATH_MAX)
+		return 0;
+
+	if (status == 1) {
+#if defined(__NR_pidfd_open) && defined(__NR_pidfd_getfd)
+		int pidfd, local;
+
+		if ((flags & AT_EMPTY_PATH) == 0 || (int) dirfd < 0)
+			return 0;
+		if (readlink_proc_pid_fd(tracee->pid, (int) dirfd, state.host_path) < 0)
+			return 0;
+		pidfd = (int) syscall(__NR_pidfd_open, tracee->pid, 0);
+		if (pidfd < 0)
+			return 0;
+		local = (int) syscall(__NR_pidfd_getfd, pidfd, (int) dirfd, 0);
+		close(pidfd);
+		if (local < 0)
+			return 0;
+		rc = syscall(__NR_statx, local, "", (int) (flags & (AT_EMPTY_PATH | AT_NO_AUTOMOUNT | AT_STATX_SYNC_TYPE)),
+			     (unsigned int) mask, &state.statx_buf);
+		close(local);
+		if (rc != 0)
+			return 0;
+#else
+		return 0;
+#endif
+	}
+	else {
+		if (state.host_path[0] != '/')
+			return 0;
+		if (strncmp(state.host_path, "/proc", 5) == 0 && (state.host_path[5] == '/' || state.host_path[5] == '\0'))
+			return 0;
+		rc = syscall(__NR_statx, AT_FDCWD, state.host_path,
+			     (int) (flags & (AT_SYMLINK_NOFOLLOW | AT_NO_AUTOMOUNT | AT_STATX_SYNC_TYPE)),
+			     (unsigned int) mask, &state.statx_buf);
+		if (rc != 0) {
+			const int error = errno;
+			if (error != ENOENT && error != ENOTDIR)
+				return 0;
+			*result = (word_t) -error;
+			return 1;
+		}
+	}
+
+	status = notify_extensions(tracee, STATX_SYSCALL, (intptr_t) &state, 0);
+	if (status < 0)
+		return 0;
+
+	if (write_data(tracee, peek_reg(tracee, ORIGINAL, SYSARG_5), &state.statx_buf, sizeof(state.statx_buf)) < 0)
+		return 0;
+
+	*result = 0;
+	return 1;
+#else
+	(void) tracee;
+	(void) result;
+	return 0;
+#endif
+}
