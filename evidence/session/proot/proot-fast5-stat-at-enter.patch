+
+/**
+ * proot-fast v5 (2026-09-25): answer the stat family at the seccomp enter stop instead of letting the syscall run
+ * and stopping again at its exit (that exit stop exists only for fake_id0's st_uid/st_gid and link2symlink's
+ * st_nlink rewrites; every stop costs ~30 us: PROOT-STAT-COST-01).  Handled: newfstatat (PR_fstatat64 on arm64)
+ * on the already translated host path, and fstat on a duplicate of the tracee's descriptor (pidfd_getfd).  The
+ * tracer applies the same rewrites in the same order as the sysexit handlers (extensions run in reverse
+ * initialization order: link2symlink, then fake_id0), writes the result into the tracee's buffer, voids the
+ * syscall with the result and restores the tracee's other argument registers.  Anything unusual takes the normal
+ * path: flags other than AT_SYMLINK_NOFOLLOW / AT_NO_AUTOMOUNT, a non-absolute or /proc path, a non-native ABI,
+ * chained syscalls, a host error other than ENOENT / ENOTDIR (EACCES first: fake_id0 retries it).
+ * PROOT_STAT_AT_ENTER=0 disables it.
+ */
+static void v5_answer(Tracee *tracee, word_t result)
+{
+	set_sysnum(tracee, PR_void);
+	poke_reg(tracee, SYSARG_2, peek_reg(tracee, ORIGINAL, SYSARG_2));
+	poke_reg(tracee, SYSARG_3, peek_reg(tracee, ORIGINAL, SYSARG_3));
+	poke_reg(tracee, SYSARG_4, peek_reg(tracee, ORIGINAL, SYSARG_4));
+	poke_reg(tracee, SYSARG_5, peek_reg(tracee, ORIGINAL, SYSARG_5));
+	poke_reg(tracee, SYSARG_6, peek_reg(tracee, ORIGINAL, SYSARG_6));
+	poke_reg(tracee, SYSARG_RESULT, result);
+	tracee->v5_answered = true;
+	tracee->restart_how = PTRACE_CONT;
+}
+
+static bool v5_stat_at_enter(Tracee *tracee)
+{
+	static int enabled = -1;
+	struct stat st;
+	char path[PATH_MAX];
+	Extension *extension;
+	Sysnum sysnum;
+	Reg buffer;
+	int status;
+
+	if (enabled < 0) {
+		const char *value = getenv("PROOT_STAT_AT_ENTER");
+		enabled = !(value != NULL && strcmp(value, "0") == 0);
+	}
+	if (!enabled)
+		return false;
+
+	sysnum = get_sysnum(tracee, ORIGINAL);
+	if (get_sysnum(tracee, CURRENT) != sysnum || tracee->chain.syscalls != NULL || tracee->sysexit_pending
+	    || get_abi(tracee) != ABI_DEFAULT)
+		return false;
+
+	/* arm64's syscall 79 (newfstatat) is PR_fstatat64 in PRoot's table; on the native 64-bit ABI both take the
+	 * kernel's struct stat.  */
+	if (sysnum == PR_newfstatat || sysnum == PR_fstatat64) {
+		word_t flags = peek_reg(tracee, CURRENT, SYSARG_4);
+
+		if ((flags & ~(word_t) (AT_SYMLINK_NOFOLLOW | AT_NO_AUTOMOUNT)) != 0)
+			return false;
+		status = read_path(tracee, path, peek_reg(tracee, CURRENT, SYSARG_2));
+		if (status < 0 || path[0] != '/')
+			return false;
+		if (strncmp(path, "/proc", 5) == 0 && (path[5] == '/' || path[5] == '\0'))
+			return false;
+
+		if (syscall(__NR_newfstatat, AT_FDCWD, path, &st, (int) flags) != 0) {
+			/* The same path fails the same way for the tracee: answer ENOENT / ENOTDIR right away
+			 * (neither fake_id0 nor link2symlink touch failed stats; Python's import probing is mostly
+			 * these).  */
+			const int error = errno;
+			if (error != ENOENT && error != ENOTDIR) {
+				VERBOSE(tracee, 2, "v5: skip host stat errno=%d %s", error, path);
+				return false;
+			}
+			VERBOSE(tracee, 2, "v5: answered errno=%d %s", error, path);
+			v5_answer(tracee, (word_t) -error);
+			return true;
+		}
+		buffer = SYSARG_3;
+	}
+	else if (sysnum == PR_fstat) {
+		const int fd = (int) peek_reg(tracee, CURRENT, SYSARG_1);
+		int pidfd, local, saved;
+
+		if (fd < 0)
+			return false;
+		pidfd = (int) syscall(__NR_pidfd_open, tracee->pid, 0);
+		if (pidfd < 0)
+			return false;
+		local = (int) syscall(__NR_pidfd_getfd, pidfd, fd, 0);
+		saved = errno;
+		close(pidfd);
+		if (local < 0) {
+			VERBOSE(tracee, 2, "v5: skip fstat getfd errno=%d fd=%d", saved, fd);
+			return false;
+		}
+		status = (int) syscall(__NR_fstat, local, &st);
+		close(local);
+		if (status != 0)
+			return false;
+
+		/* What link2symlink's fstat sysexit handler looks at: the descriptor's path.  */
+		path[0] = '\0';
+		if (get_extension(tracee, link2symlink_callback) != NULL
+		    && readlink_proc_pid_fd(tracee->pid, fd, path) >= 0) {
+			const size_t length = strlen(path), suffix = strlen(" (deleted)");
+			if (length > suffix && strcmp(path + length - suffix, " (deleted)") == 0)
+				path[length - suffix] = '\0';
+		}
+		buffer = SYSARG_2;
+	}
+	else
+		return false;
+
+	if (path[0] != '\0' && get_extension(tracee, link2symlink_callback) != NULL) {
+		struct stat l2s;
+		status = l2s_stat_override(path, &l2s);
+		if (status < 0)
+			return false;
+		if (status > 0)
+			st = l2s;
+	}
+
+	extension = get_extension(tracee, fake_id0_callback);
+	if (extension != NULL && extension->config != NULL) {
+		const Config *config = extension->config;
+		if (st.st_uid == getuid())
+			st.st_uid = config->suid;
+		if (st.st_gid == getgid())
+			st.st_gid = config->sgid;
+	}
+
+	if (write_data(tracee, peek_reg(tracee, ORIGINAL, buffer), &st, sizeof(st)) < 0)
+		return false;
+
+	VERBOSE(tracee, 2, "v5: answered %s", sysnum == PR_fstat ? "fstat" : path);
+	v5_answer(tracee, 0);
+	return true;
+}
