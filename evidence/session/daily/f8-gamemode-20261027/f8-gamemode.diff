     "$P/adb" kill-server >/dev/null 2>&1
-    log "no wireless debugging: adb server killed, opening Developer options"
-    say "F8 遊戲模式：請手動關閉「USB 偵錯」和「無線偵錯」，再從 Termux 通知按 Exit"
+    log "manual: $MANUAL; adb server killed, opening Developer options"
+    say "F8 遊戲模式：$MANUAL，偵錯沒有關。請手動關閉「USB 偵錯」和「無線偵錯」$UNPLUG，再從 Termux 通知按 Exit"
     am start -a android.settings.APPLICATION_DEVELOPMENT_SETTINGS >/dev/null 2>&1
     exit 0
 fi
